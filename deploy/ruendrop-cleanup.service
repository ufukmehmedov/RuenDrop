[Unit]
Description=Delete expired RuenDrop ciphertext

[Service]
Type=oneshot
User=ruendrop
Group=ruendrop
WorkingDirectory=/opt/ruendrop
EnvironmentFile=/etc/ruendrop/app.env
ExecStart=/opt/ruendrop/.venv/bin/python -m ruendrop.admin cleanup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ruendrop
NoExecPaths=/var/lib/ruendrop
MemoryMax=96M
